#!/bin/bash

if [ $# -gt 0 ]; then
    type=$1
    case "$type" in
        wifi) type=802-11-wireless ;;
        ethernet) type=802-3-ethernet ;;
    esac
    nmcli -t -f TYPE,NAME connection show --active |
        awk -F: -v type="$type" '$1 == type { print $2 }'
    exit
fi

device=$(
    ip -4 route get 1.1.1.1 2>/dev/null |
        awk '{ for (i = 1; i <= NF; i++) if ($i == "dev") { print $(i + 1); exit } }'
)

if [ -z "$device" ]; then
    echo "ERROR: No IPv4 default route found" >&2
    exit 1
fi

nmcli -g GENERAL.CONNECTION device show "$device"
